---
import Icon from '../primitives/Icon.astro';
---

<!-- Shipped hidden: the script shows it, so visitors without JavaScript never see a button that does nothing. -->
<button class="theme-toggle" type="button" data-theme-toggle hidden aria-pressed="false">
  <span class="visually-hidden">Dark colours</span>
  <Icon name="moon" class="when-light" />
  <Icon name="sun" class="when-dark" />
</button>

<script>
  const KEY = 'forge-theme';
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme ? root.dataset.theme === 'dark' : getComputedStyle(root).colorScheme.includes('dark');

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(isDark()));
    button.hidden = false;
    sync();
    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(KEY, next);
      } catch {
        // Private browsing can refuse storage. The choice then lasts for this page only.
      }
      sync();
    });
  }
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-button);
    background: transparent;
    color: var(--color-text);
  }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle[aria-pressed='true'] :global(.when-light),
  .theme-toggle[aria-pressed='false'] :global(.when-dark) { display: none; }
</style>
