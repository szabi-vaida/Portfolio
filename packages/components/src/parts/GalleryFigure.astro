---
import { getImage } from 'astro:assets';
import Image from '../primitives/Image.astro';
import { localImage } from '../lib/images';

interface Props {
  item: { src: string; alt: string; caption?: string };
  ratio?: string;
  sizes?: string;
  /** Link to a larger copy that the lightbox opens. Off in the carousel, which already shows photos large. */
  zoom?: boolean;
}

const { item, ratio, sizes = '(min-width: 56rem) 33vw, 50vw', zoom = true } = Astro.props;
const local = localImage(item.src);
// The larger copy the lightbox opens, also served from the site.
const full = zoom
  ? (local
      ? await getImage({ src: local, width: Math.min(local.width, 2000), format: 'webp' })
      : await getImage({ src: item.src, inferSize: true, format: 'webp' })
    ).src
  : undefined;
---

<figure class="gallery-figure">
  {
    full ? (
      <a href={full} data-lightbox data-caption={item.caption} class="gallery-link">
        <Image image={item} ratio={ratio} sizes={sizes} widths={[400, 700, 1000, 1400]} />
        <span class="visually-hidden">Open larger</span>
      </a>
    ) : (
      <Image image={item} ratio={ratio} sizes={sizes} widths={[600, 900, 1200, 1600]} />
    )
  }
  {item.caption && <figcaption>{item.caption}</figcaption>}
</figure>

<style>
  .gallery-figure { margin: 0; }
  .gallery-link {
    display: block;
    border-radius: var(--radius-m);
    overflow: hidden;
    cursor: zoom-in;
  }
  .gallery-figure :global(img) {
    border-radius: var(--radius-m);
    transition: transform 500ms var(--ease-out), filter 300ms var(--ease-out);
  }
  .gallery-link:hover :global(img) { transform: scale(1.025); }
  figcaption {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-s);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery-link:hover :global(img) { transform: none; }
  }
</style>
