---
import type { CollectionEntry } from 'astro:content';
import Image from '../primitives/Image.astro';
import { formatDate } from '../lib/site';

interface Props {
  posts: CollectionEntry<'posts'>[];
  /** Where posts live, such as /blog/. */
  base: string;
  locale: string;
  variant: 'list' | 'cards';
  /** The heading level of each post title. */
  level?: 2 | 3;
}

const { posts, base, locale, variant, level = 3 } = Astro.props;
const Title = `h${level}` as 'h2' | 'h3';
---

{
  posts.length === 0 ? (
    <p class="empty">New posts will appear here soon.</p>
  ) : (
    <ol class="posts" data-variant={variant} role="list">
      {posts.map((post) => (
        <li class="post">
          {variant === 'cards' && post.data.image && post.data.alt && (
            <div class="post-media">
              <Image image={{ src: post.data.image, alt: post.data.alt }} ratio="3/2" widths={[400, 800]} sizes="(min-width: 56rem) 24rem, 100vw" />
            </div>
          )}
          <div class="post-body">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
            <Title class="post-title">
              <a href={`${base}${post.id}/`}>{post.data.title}</a>
            </Title>
            <p>{post.data.description}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .posts { margin: 0; }
  .post { position: relative; }
  .post time {
    color: var(--color-muted);
    font-size: var(--text-s);
    font-variant-numeric: tabular-nums;
  }
  .post-title {
    font-size: var(--text-l);
    margin-block: var(--space-3xs) var(--space-2xs);
  }
  .post-title a { text-decoration: none; }
  /* The whole post is one link target, while the title stays the only link for screen readers. */
  .post-title a::after { content: ''; position: absolute; inset: 0; }
  .post-title a:hover { text-decoration: underline; }
  .post p { color: var(--color-muted); max-width: 60ch; }
  .post:focus-within { outline: 2px solid var(--color-primary); outline-offset: 6px; border-radius: var(--radius-s); }
  .post :global(a:focus-visible) { outline: none; }

  /* List: a ruled index of titles, newest first. */
  .posts[data-variant='list'] .post {
    padding-block: var(--space-l);
    border-top: 1px solid var(--hairline);
  }
  .posts[data-variant='list'] .post:last-child { border-bottom: 1px solid var(--hairline); }
  @media (min-width: 48rem) {
    .posts[data-variant='list'] .post-body {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      column-gap: var(--space-xl);
    }
    .posts[data-variant='list'] time { grid-row: 1 / span 2; padding-top: 0.35em; }
  }

  /* Cards: cover images in a grid. */
  .posts[data-variant='cards'] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-xl) var(--space-l);
  }
  .posts[data-variant='cards'] .post-media {
    margin-bottom: var(--space-s);
    border-radius: var(--radius-m);
    overflow: hidden;
  }
  .posts[data-variant='cards'] .post-media :global(img) { transition: transform 400ms var(--ease-out); }
  .posts[data-variant='cards'] .post:hover .post-media :global(img) { transform: scale(1.03); }

  .empty { color: var(--color-muted); }

  @media (prefers-reduced-motion: reduce) {
    .posts[data-variant='cards'] .post:hover .post-media :global(img) { transform: none; }
  }
</style>
