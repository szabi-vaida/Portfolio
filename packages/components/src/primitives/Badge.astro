---
interface Props {
  /** neutral for labels such as a category, accent for news such as New, strong for a status such as Sold out. */
  tone?: 'neutral' | 'accent' | 'strong';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', className]} data-tone={tone}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2em 0.65em;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .badge[data-tone='neutral'] { background: var(--color-tinted); color: var(--color-muted); border: 1px solid var(--hairline); }
  .badge[data-tone='accent'] { background: color-mix(in oklab, var(--color-accent) 14%, var(--color-surface)); color: var(--color-text); border: 1px solid color-mix(in oklab, var(--color-accent) 40%, transparent); }
  .badge[data-tone='strong'] { background: var(--color-text); color: var(--color-background); }
</style>
