---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  /** raised adds the theme shadow, outlined a hairline border, plain only the surface colour. */
  look?: 'raised' | 'outlined' | 'plain';
  highlight?: boolean;
  class?: string;
}

const { as: Tag = 'div', look = 'outlined', highlight = false, class: className } = Astro.props;
---

<Tag class:list={['card', className]} data-look={look} data-highlight={highlight ? '' : undefined}><slot /></Tag>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-l);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    color: var(--color-text);
  }
  .card[data-look='outlined'] { border: 1px solid var(--hairline); }
  .card[data-look='raised'] { box-shadow: var(--shadow-l); }
  .card[data-highlight] { border: 1px solid var(--color-primary); box-shadow: var(--shadow-l); }
</style>
