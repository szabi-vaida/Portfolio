---
import type { HTMLTag } from 'astro/types';

interface Props {
  /** narrow suits reading text, wide suits photo grids. */
  size?: 'default' | 'narrow' | 'wide';
  as?: HTMLTag;
  class?: string;
}

const { size = 'default', as: Tag = 'div', class: className } = Astro.props;
---

<Tag class:list={['container', className]} data-size={size === 'default' ? undefined : size}><slot /></Tag>
