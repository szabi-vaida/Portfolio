---
import type { SectionOf } from '@forge/schema';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Image from '../primitives/Image.astro';
import type { SectionProps } from '../lib/site';

type Props = SectionProps<SectionOf<'cta'>>;

const { section, anchor, first } = Astro.props;
const { variant, heading, intro, actions, image } = section;
// A banner is bold unless the site asks otherwise. The other layouts follow the chosen background.
const tone = variant === 'banner' && section.tone === 'plain' ? 'bold' : section.tone;
const look = variant === 'split' && !image ? 'centred' : variant;
---

<section id={anchor} class="cta" data-variant={look} data-tone={tone} data-reveal={first ? undefined : ''} aria-labelledby={`${anchor}-title`}>
  <Container size={look === 'centred' ? 'narrow' : 'default'} class="cta-inner">
    <div class="cta-copy">
      <Heading level={first ? 1 : 2} size={look === 'banner' ? 'l' : 'xl'} id={`${anchor}-title`}>{heading}</Heading>
      {intro && <p>{intro}</p>}
    </div>
    <div class="cta-actions">
      {
        actions.map((a, i) => (
          <Button href={a.href} variant={i === 0 ? 'primary' : 'secondary'} size="l">
            {a.label}
          </Button>
        ))
      }
    </div>
    {
      look === 'split' && image && (
        <div class="cta-media">
          <Image image={image} ratio="4/3" sizes="(min-width: 56rem) 40vw, 100vw" />
        </div>
      )
    }
  </Container>
</section>

<style>
  .cta { padding-block: var(--section-space); }
  .cta :global(.cta-inner) { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-l); }
  .cta-copy { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-s); }
  .cta-copy p { color: var(--color-muted); font-size: var(--text-m); max-width: 50ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: var(--space-xs); }

  /* Centred: a calm closing line with its buttons underneath. */
  .cta[data-variant='centred'] :global(.cta-inner) { justify-items: center; text-align: center; }
  .cta[data-variant='centred'] .cta-copy { justify-items: center; }
  .cta[data-variant='centred'] .cta-actions { justify-content: center; }

  /* Banner: a strong band with the words on the left and the buttons on the right. */
  .cta[data-variant='banner'] { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  @media (min-width: 56rem) {
    .cta[data-variant='banner'] :global(.cta-inner) {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2xl);
    }
  }

  /* Split: a photo beside the words. */
  .cta-media { border-radius: var(--radius-l); overflow: hidden; }
  @media (min-width: 56rem) {
    .cta[data-variant='split'] :global(.cta-inner) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'copy media' 'actions media';
      align-items: center;
      column-gap: var(--space-2xl);
    }
    .cta[data-variant='split'] .cta-copy { grid-area: copy; align-self: end; }
    .cta[data-variant='split'] .cta-actions { grid-area: actions; align-self: start; }
    .cta[data-variant='split'] .cta-media { grid-area: media; }
  }
</style>
