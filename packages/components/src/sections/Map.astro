---
import type { SectionOf } from '@forge/schema';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import Image from '../primitives/Image.astro';
import Section from '../primitives/Section.astro';
import type { SectionProps } from '../lib/site';

type Props = SectionProps<SectionOf<'map'>>;

const { section, anchor, first } = Astro.props;
const { variant, tone, heading, intro, address, url, linkLabel, image } = section;
// A link to a maps site, never an embedded map: no third-party request and no cookie banner needed.
---

<Section anchor={anchor} tone={tone} heading={heading} intro={intro} align="split" first={first}>
  <div class="map" data-variant={variant}>
    {
      image && (
        <a class="map-media" href={url} rel="noopener" tabindex="-1" aria-hidden="true">
          <Image image={image} ratio={variant === 'wide' ? '21/9' : '4/3'} sizes={variant === 'wide' ? '(min-width: 74rem) 74rem, 100vw' : '(min-width: 56rem) 50vw, 100vw'} />
        </a>
      )
    }
    <div class="map-body">
      <p class="address">
        <Icon name="pin" size={1.3} />
        <span>{address}</span>
      </p>
      <Button href={url} variant="secondary" icon="arrow-up-right">{linkLabel}</Button>
    </div>
  </div>
</Section>

<style>
  .map { display: grid; gap: var(--space-l); }
  .map-media { display: block; border-radius: var(--radius-l); overflow: hidden; }
  .map-body { display: grid; gap: var(--space-m); justify-items: start; align-content: center; }
  .address { display: flex; gap: var(--space-s); font-size: var(--text-l); white-space: pre-line; line-height: 1.4; }
  .address :global(svg) { margin-top: 0.15em; color: var(--color-accent); }
  @media (min-width: 56rem) {
    .map[data-variant='card'] { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: var(--space-2xl); align-items: center; }
  }
</style>
