---
import type { SectionOf } from '@forge/schema';
import Section from '../primitives/Section.astro';
import type { SectionProps } from '../lib/site';

type Props = SectionProps<SectionOf<'menu'>>;

const { section, anchor, first } = Astro.props;
// Item titles sit one level below the section heading, which is the h1 when the section opens the page.
const H = first ? 'h2' : 'h3';
const { variant, tone, heading, intro, groups, note } = section;
---

<Section anchor={anchor} tone={tone} heading={heading} intro={intro} align="centre" width={variant === 'list' ? 'narrow' : 'default'} first={first}>
  <div class="menu" data-variant={variant}>
    {
      groups.map((group) => (
        <section class="group" aria-labelledby={`${anchor}-${group.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          <header class="group-head">
            <H id={`${anchor}-${group.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{group.name}</H>
            {group.note && <p>{group.note}</p>}
          </header>
          <ul class="items" role="list">
            {group.items.map((item) => (
              <li class="item">
                <div class="item-line">
                  <span class="item-name">{item.name}</span>
                  <span class="leader" aria-hidden="true" />
                  <span class="item-price">{item.price}</span>
                </div>
                {item.description && <p class="item-description">{item.description}</p>}
                {item.tags && item.tags.length > 0 && (
                  <p class="tags">
                    {item.tags.map((t) => (
                      <span class="tag">{t}</span>
                    ))}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  {note && <p class="note">{note}</p>}
</Section>

<style>
  .menu { display: grid; gap: var(--space-2xl); }
  .group-head {
    display: grid;
    justify-items: center;
    gap: var(--space-3xs);
    margin-bottom: var(--space-m);
    text-align: center;
  }
  .group-head :is(h2, h3) {
    font-size: var(--text-xl);
  }
  .group-head p { color: var(--color-muted); font-size: var(--text-s); font-style: italic; }
  .items { display: grid; gap: var(--space-m); }

  /* A dotted leader joins each dish to its price, as on a printed menu. */
  .item-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }
  .item-name { font-weight: 600; font-size: var(--text-m); }
  .leader {
    flex: 1;
    min-width: 1rem;
    border-bottom: 1px dotted color-mix(in oklab, var(--color-text) 40%, transparent);
    transform: translateY(-0.3em);
  }
  .item-price { font-variant-numeric: tabular-nums; font-weight: 600; }
  .item-description { margin-top: var(--space-3xs); color: var(--color-muted); max-width: 52ch; }
  .tags { display: flex; gap: 0.35rem; margin-top: var(--space-3xs); }
  .tag {
    padding: 0 0.45em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    color: var(--color-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .note { margin-top: var(--space-2xl); color: var(--color-muted); font-size: var(--text-s); text-align: center; }

  /* Columns: groups side by side on wide screens, like a two-page menu. */
  @media (min-width: 56rem) {
    .menu[data-variant='columns'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-2xl) var(--space-3xl);
    }
  }
</style>
