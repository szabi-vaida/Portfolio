---
import type { SectionOf } from '@forge/schema';
import Section from '../primitives/Section.astro';
import type { SectionProps } from '../lib/site';

type Props = SectionProps<SectionOf<'stats'>>;

const { section, anchor, first } = Astro.props;
const { variant, tone, heading, intro, items } = section;
---

<Section anchor={anchor} tone={tone} heading={heading} intro={intro} align="split" first={first}>
  <dl class="stats" data-variant={variant} style={`--count:${items.length}`}>
    {
      items.map((item) => (
        <div class="stat">
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .stats { display: grid; }
  .stat { display: flex; flex-direction: column-reverse; gap: var(--space-3xs); }
  dt { color: var(--color-muted); font-size: var(--text-s); max-width: 22ch; }
  dd {
    font-family: var(--font-heading);
    font-weight: var(--heading-weight);
    font-size: var(--text-3xl);
    letter-spacing: var(--heading-tracking);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  /* Row: numbers side by side, divided by hairlines. */
  .stats[data-variant='row'] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-l);
  }
  .stats[data-variant='row'] .stat { padding-top: var(--space-s); border-top: 1px solid var(--color-border); }

  /* Tiles: numbers in soft blocks, the first one in the accent colour. */
  .stats[data-variant='tiles'] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-s);
  }
  .stats[data-variant='tiles'] .stat {
    padding: var(--space-l);
    border-radius: var(--radius-m);
    background: var(--color-surface);
    border: 1px solid var(--hairline);
    justify-content: flex-end;
    min-height: 10rem;
  }
  .stats[data-variant='tiles'] .stat:first-child {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }
  .stats[data-variant='tiles'] .stat:first-child dt { color: color-mix(in oklab, var(--color-on-primary) 82%, var(--color-primary)); }
</style>
