---
import type { SectionOf } from '@forge/schema';
import Icon from '../primitives/Icon.astro';
import Section from '../primitives/Section.astro';
import type { SectionProps } from '../lib/site';

type Props = SectionProps<SectionOf<'timeline'>>;

const { section, anchor, first } = Astro.props;
// Item titles sit one level below the section heading, which is the h1 when the section opens the page.
const H = first ? 'h2' : 'h3';
const { variant, tone, heading, intro, items } = section;
---

<Section anchor={anchor} tone={tone} heading={heading} intro={intro} align="split" width={variant === 'line' ? 'narrow' : 'default'} first={first}>
  <ol class="timeline" data-variant={variant} role="list">
    {
      items.map((item) => (
        <li class="entry">
          <p class="date">{item.date}</p>
          <div class="entry-body">
            <H>{item.title}</H>
            {item.place && (
              <p class="place">
                <Icon name="pin" size={1} />
                {item.place}
              </p>
            )}
            {item.text && <p class="text">{item.text}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .date { color: var(--color-accent); font-weight: 600; font-variant-numeric: tabular-nums; }
  .entry :is(h2, h3) { font-size: var(--text-l); }
  .place { display: flex; align-items: center; gap: 0.35em; color: var(--color-muted); font-size: var(--text-s); margin-top: var(--space-3xs); }
  .text { margin-top: var(--space-2xs); color: var(--color-muted); max-width: 56ch; }

  /* Line: a vertical rule with a dot for each entry. Good for a history or a career. */
  .timeline[data-variant='line'] {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding-left: var(--space-xl);
  }
  .timeline[data-variant='line']::before {
    content: '';
    position: absolute;
    left: 0.35rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--color-border);
  }
  /* The rule fills in the accent colour as the timeline scrolls through the window. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .timeline[data-variant='line']::after {
        content: '';
        position: absolute;
        left: 0.35rem;
        top: 0.5rem;
        bottom: 0.5rem;
        width: 2px;
        margin-left: -0.5px;
        background: var(--color-accent);
        transform-origin: top;
        animation-name: timeline-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 40% cover 55%;
      }
    }
  }
  @keyframes timeline-draw {
    from { transform: scaleY(0); }
  }
  .timeline[data-variant='line'] .entry { position: relative; }
  .timeline[data-variant='line'] .entry::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-xl) + 0.05rem);
    top: 0.4rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--color-background);
    border: 2px solid var(--color-accent);
    z-index: 1;
  }

  /* List: a schedule of dated rows. Good for events and opening dates. */
  .timeline[data-variant='list'] { border-top: 1px solid var(--color-border); }
  .timeline[data-variant='list'] .entry {
    display: grid;
    gap: var(--space-2xs);
    padding-block: var(--space-l);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 48rem) {
    .timeline[data-variant='list'] .entry { grid-template-columns: 12rem minmax(0, 1fr); gap: var(--space-xl); }
    .timeline[data-variant='list'] .date { font-family: var(--font-heading); font-size: var(--text-l); font-weight: var(--heading-weight); line-height: 1.2; }
  }
</style>
